---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'La Salerosa — Mar Morán · Aurelio Viribay | Cristóbal Oudrid',
	description = 'Lanzamiento oficial del single "La Salerosa", de las Canciones Líricas de Cristóbal Oudrid interpretadas por Mar Morán y Aurelio Viribay.',
	image = '/images/cover-1800.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="h-dvh w-full overflow-hidden bg-[#160402]">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#160402" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Social -->
		<meta property="og:type" content="music.song" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Google Fonts: Pinyon Script (400), Cinzel (400, 500, 600) & Montserrat (200, 300, 500) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Montserrat:wght@200;300;500&family=Pinyon+Script&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="h-dvh w-full overflow-hidden bg-[#160402] text-[#FFFDF9] font-['Montserrat'] select-none">
		<slot />
	</body>
</html>
