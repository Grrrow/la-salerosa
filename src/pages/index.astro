---
import Layout from "../layouts/Layout.astro";
import LogoLaSalerosa from "../components/LogoLaSalerosa.astro";
import LogoWorldPremiere from "../components/LogoWorldPremiere.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout>
	<div
		class="relative flex flex-col justify-between w-full h-dvh overflow-hidden bg-[#160402]"
	>
		<!-- CAPA 0: Imagen de Fondo Responsiva (9:16 dedicada en móvil + 16:9 centrada en desktop) -->
		<div class="fixed inset-0 z-0 bg-[#160402] overflow-hidden">
			<picture class="block w-full h-full">
				<source
					media="(max-width: 639px)"
					srcset={`${base}/portada-la-salerosa-mobile.webp`}
					type="image/webp"
					width="828"
					height="1472"
				/>
				<source
					media="(max-width: 639px)"
					srcset={`${base}/portada-la-salerosa-mobile.jpg`}
					type="image/jpeg"
					width="1080"
					height="1920"
				/>
				<source
					media="(min-width: 640px)"
					srcset={`${base}/portada-la-salerosa-desktop.webp`}
					type="image/webp"
					width="1920"
					height="1080"
				/>
				<img
					src={`${base}/portada-la-salerosa-desktop.jpg`}
					alt="Mar Morán en la portada de La Salerosa — Canciones Líricas de Cristóbal Oudrid junto al pianista Aurelio Viribay"
					width="2560"
					height="1440"
					fetchpriority="high"
					class="w-full h-full object-cover object-center select-none pointer-events-none"
				/>
			</picture>

			<!-- Audio del adelanto oficial ("La Salerosa"): se carga bajo demanda solo al hacer clic -->
			<audio
				id="preview-audio"
				data-src={`${base}/audio/02-La%20salerosa'web.mp3`}
				loop
				preload="none"></audio>
		</div>

		<!-- Overlays de lectura, Ondas Armónicas Interactivas y Constelación de Canciones (Capa z-10, pointer-events-none) -->
		<div
			class="fixed inset-0 z-10 pointer-events-none overflow-hidden"
			aria-hidden="true"
		>
			<!-- Tinte cálido general muy sutil -->
			<div class="absolute inset-0 bg-[#160402]/20 mix-blend-multiply">
			</div>
			<div
				class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_40%,#160402_100%)] opacity-45"
			>
			</div>

			<!-- Haces de luz viva (fuego/ámbar) en modo screen sobre los destellos de la portada -->
			<div class="absolute inset-0 stage-beam-right"></div>
			<div class="absolute inset-0 stage-beam-left"></div>

			<!-- Canvas de Ondas Armónicas de Luz e Interacción en el Fondo (enmascarado detrás de Mar) -->
			<canvas
				id="harmonic-waves"
				class="absolute inset-0 w-full h-full mix-blend-screen opacity-75 background-sky-mask"
			></canvas>

			<!-- Capa de Títulos del Repertorio (16 canciones que aparecen poco a poco como estelas fugaces) -->
			<div
				id="song-constellation"
				class="absolute inset-0 w-full h-full overflow-hidden"
			>
			</div>

			<!-- Degradado superior suave para realzar el brillo neón de LA SALEROSA y MAR MORÁN -->
			<div
				class="absolute inset-x-0 top-0 bg-gradient-to-b from-[#160402]/80 via-[#160402]/30 to-transparent h-40 sm:h-48"
			>
			</div>

			<!-- Degradado inferior (tipo escenario) -->
			<div
				class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#160402] via-[#160402]/85 to-transparent h-[42dvh] sm:h-[38dvh]"
			>
			</div>
		</div>

		<!-- CAPA 1: Bloque Superior — Título "LA SALEROSA" de brazo a brazo, "MAR MORÁN" y créditos encima de la cabeza -->
		<header
			class="relative z-20 w-full px-4 pt-2.5 sm:px-8 sm:pt-5 md:pt-6 flex flex-col items-center"
		>
			<!-- Barra de controles editoriales sin caja: en móvil arriba centrados (Sonido + ES/EN); en desktop Sonido abajo-derecha y Selector ES/EN arriba-derecha -->
			<div
				class="relative z-30 w-full flex items-center justify-center gap-4 sm:gap-0 mb-1 sm:mb-0"
			>
				<div
					class="sm:fixed sm:bottom-8 sm:right-8 md:bottom-10 md:right-12 sm:z-30 animate-fade-up-1"
				>
					<button
						id="sound-toggle"
						type="button"
						data-sound-active="false"
						aria-pressed="false"
						aria-label="Activar sonido del adelanto"
						class="group py-1.5 px-2 flex items-center gap-2.5 text-[#F7E6CA]/85 hover:text-[#FFFDF9] transition-all cursor-pointer"
					>
						<!-- Onda armónica centrada en el eje del texto (5 barritas simétricas) -->
						<span
							class="flex items-center gap-[2.5px] h-3"
							aria-hidden="true"
						>
							<span
								class="sound-bar w-[1.5px] h-full rounded-full bg-[#F29F38]/80 group-hover:bg-[#F29F38]"
							></span>
							<span
								class="sound-bar w-[1.5px] h-full rounded-full bg-[#F29F38]/90 group-hover:bg-[#F29F38]"
							></span>
							<span
								class="sound-bar w-[1.5px] h-full rounded-full bg-[#F29F38] group-hover:bg-[#FFFDF9]"
							></span>
							<span
								class="sound-bar w-[1.5px] h-full rounded-full bg-[#F29F38]/90 group-hover:bg-[#F29F38]"
							></span>
							<span
								class="sound-bar w-[1.5px] h-full rounded-full bg-[#F29F38]/80 group-hover:bg-[#F29F38]"
							></span>
						</span>
						<span
							id="sound-toggle-label"
							class="neon-subtitle font-['Montserrat'] font-light text-[10.5px] sm:text-xs tracking-[0.24em] sm:tracking-[0.26em] uppercase leading-none"
							>Activar sonido</span
						>
						<span
							class="hidden sm:block w-6 h-px bg-gradient-to-r from-[#F29F38]/60 to-transparent transition-all duration-300 group-hover:w-9 group-hover:from-[#F29F38]"
							aria-hidden="true"></span>
					</button>
				</div>

				<span
					class="sm:hidden w-px h-3 bg-[#F7E6CA]/25"
					aria-hidden="true"></span>

				<!-- Selector de idioma editorial ES / EN -->
				<div
					role="group"
					aria-label="Selector de idioma / Language selector"
					class="flex items-center gap-1.5 sm:fixed sm:top-6 sm:right-8 md:top-7 md:right-12 sm:z-30 font-['Montserrat'] text-[10.5px] sm:text-xs tracking-[0.24em] uppercase animate-fade-up-1"
				>
					<button
						type="button"
						data-lang-btn="es"
						aria-pressed="true"
						class="neon-subtitle font-medium text-[#F29F38] hover:text-[#FFFDF9] transition-colors px-1.5 py-1 cursor-pointer"
					>
						ES
					</button>
					<span class="text-[#F7E6CA]/35 select-none">/</span>
					<button
						type="button"
						data-lang-btn="en"
						aria-pressed="false"
						class="neon-subtitle font-light text-[#F7E6CA]/55 hover:text-[#FFFDF9] transition-colors px-1.5 py-1 cursor-pointer"
					>
						EN
					</button>
				</div>
			</div>

			<!-- 1. Bloque del Título ("LA SALEROSA" con halo de neón cálido e incandescencia en movimiento) -->
			<h1
				class="w-full flex justify-center select-none pointer-events-none animate-fade-up-1"
			>
				<span class="sr-only"
					>La Salerosa — Canciones Líricas de Cristóbal Oudrid · Mar
					Morán (soprano) y Aurelio Viribay (piano)</span
				>
				<LogoLaSalerosa
					class="w-[90vw] sm:w-[54vw] max-w-none h-auto"
				/>
			</h1>

			<!-- 2. Subtítulo de Artista ("MAR MORÁN") en #F7E6CA con resplandor cálido -->
			<p
				class="neon-subtitle font-['Montserrat'] font-light text-[15px] sm:text-[clamp(1.1rem,1.6vw,1.55rem)] uppercase tracking-[0.58em] sm:tracking-[0.65em] text-[#F7E6CA] mt-0.5 sm:mt-1.5 pl-[0.58em] sm:pl-[0.65em] text-center animate-fade-up-2"
			>
				MAR MORÁN
			</p>

			<!-- 3. Créditos de Obra y Piano debajo de Mar Morán y encima de su cabeza -->
			<div
				class="font-['Montserrat'] uppercase flex flex-col items-center gap-0.5 sm:gap-1 mt-1 sm:mt-2 text-center animate-fade-up-2"
			>
				<p
					data-i18n="creditsSongs"
					class="neon-subtitle font-medium tracking-[0.15em] sm:tracking-[0.25em] text-[10px] sm:text-xs md:text-[13px] text-[#F7E6CA] pl-[0.15em] sm:pl-[0.25em]"
				>
					CANCIONES LÍRICAS DE CRISTÓBAL OUDRID
				</p>
				<p
					data-i18n="creditsPiano"
					class="neon-subtitle font-medium tracking-[0.2em] sm:tracking-[0.28em] text-[10px] sm:text-xs md:text-[13px] text-[#F7E6CA] pl-[0.2em] sm:pl-[0.28em]"
				>
					AURELIO VIRIBAY · PIANO
				</p>
			</div>
		</header>

		<!-- Sello Oficial del Disco en Desktop: sobre los pliegues inferiores izquierdos del vestido (como en la portada física) -->
		<div
			class="hidden sm:block fixed bottom-8 left-8 md:bottom-10 md:left-12 z-20 pointer-events-none animate-fade-up-3"
		>
			<LogoWorldPremiere
				class="w-28 md:w-32 lg:w-36 h-auto opacity-95"
			/>
		</div>

		<!-- CAPA 2: Contenedor Principal Inferior Minimalista y Escultórico (z-20) -->
		<main
			class="relative z-20 mt-auto w-full max-w-xl mx-auto px-4 sm:px-6 pb-2 sm:pb-4 text-center flex flex-col items-center"
		>
			<!-- 1. Bloque de Cuenta Atrás del Primer Single -->
			<div
				class="flex flex-col items-center mb-4 sm:mb-5 animate-fade-up-3"
			>
				<!-- Etiqueta editorial integrada con filetes de luz que explica qué mide la cuenta atrás -->
				<div
					class="flex items-center justify-center gap-2.5 sm:gap-3.5 mb-2.5 sm:mb-2 w-full"
				>
					<span
						class="w-6 sm:w-12 h-px shrink-0 bg-gradient-to-r from-transparent to-[#F29F38]/70"
						aria-hidden="true"></span>
					<span
						data-i18n="countdownBadge"
						class="font-['Montserrat'] font-medium text-[11.5px] sm:text-[10px] tracking-[0.16em] sm:tracking-[0.28em] uppercase text-[#F29F38] drop-shadow-[0_0_8px_rgba(242,159,56,0.65)] pl-[0.16em] sm:pl-[0.28em] whitespace-nowrap"
					>
						Estreno primer single 12 de Nov
					</span>
					<span
						class="w-6 sm:w-12 h-px shrink-0 bg-gradient-to-l from-transparent to-[#F29F38]/70"
						aria-hidden="true"></span>
				</div>

				<div
					aria-label="Cuenta atrás para el estreno del primer single"
					class="flex items-center justify-center gap-4 sm:gap-5"
				>
					<div
						class="flex flex-col items-center min-w-[62px] sm:min-w-[56px]"
					>
						<span
							id="cd-days"
							class="neon-subtitle font-['Cinzel'] text-[42px] sm:text-3xl md:text-4xl text-[#FFFDF9] tracking-[0.06em] leading-none tabular-nums"
							>03</span
						>
						<span
							data-i18n="unitDays"
							class="font-['Montserrat'] text-[10.5px] sm:text-[9px] tracking-[0.26em] sm:tracking-[0.28em] uppercase text-[#D4A383] mt-1.5 sm:mt-1 pl-[0.26em] sm:pl-[0.28em]"
							>Días</span
						>
					</div>

					<span
						class="font-['Cinzel'] text-2xl sm:text-2xl text-[#F29F38]/70 -mt-4 sm:-mt-3 select-none"
						>:</span
					>

					<div
						class="flex flex-col items-center min-w-[62px] sm:min-w-[56px]"
					>
						<span
							id="cd-hours"
							class="neon-subtitle font-['Cinzel'] text-[42px] sm:text-3xl md:text-4xl text-[#FFFDF9] tracking-[0.06em] leading-none tabular-nums"
							>00</span
						>
						<span
							data-i18n="unitHours"
							class="font-['Montserrat'] text-[10.5px] sm:text-[9px] tracking-[0.26em] sm:tracking-[0.28em] uppercase text-[#D4A383] mt-1.5 sm:mt-1 pl-[0.26em] sm:pl-[0.28em]"
							>Horas</span
						>
					</div>

					<span
						class="font-['Cinzel'] text-2xl sm:text-2xl text-[#F29F38]/70 -mt-4 sm:-mt-3 select-none"
						>:</span
					>

					<div
						class="flex flex-col items-center min-w-[62px] sm:min-w-[56px]"
					>
						<span
							id="cd-mins"
							class="neon-subtitle font-['Cinzel'] text-[42px] sm:text-3xl md:text-4xl text-[#FFFDF9] tracking-[0.06em] leading-none tabular-nums"
							>00</span
						>
						<span
							data-i18n="unitMins"
							class="font-['Montserrat'] text-[10.5px] sm:text-[9px] tracking-[0.26em] sm:tracking-[0.28em] uppercase text-[#D4A383] mt-1.5 sm:mt-1 pl-[0.26em] sm:pl-[0.28em]"
							>Min</span
						>
					</div>

					<span
						class="font-['Cinzel'] text-2xl sm:text-2xl text-[#F29F38]/70 -mt-4 sm:-mt-3 select-none"
						>:</span
					>

					<div
						class="flex flex-col items-center min-w-[62px] sm:min-w-[56px]"
					>
						<span
							id="cd-secs"
							class="neon-subtitle font-['Cinzel'] text-[42px] sm:text-3xl md:text-4xl text-[#F29F38] tracking-[0.06em] leading-none tabular-nums"
							>00</span
						>
						<span
							data-i18n="unitSecs"
							class="font-['Montserrat'] text-[10.5px] sm:text-[9px] tracking-[0.26em] sm:tracking-[0.28em] uppercase text-[#D4A383] mt-1.5 sm:mt-1 pl-[0.26em] sm:pl-[0.28em]"
							>Seg</span
						>
					</div>
				</div>
			</div>

			<!-- 3. Bloque Minimalista de Aviso de Lanzamiento -->
			<div class="w-full max-w-lg mx-auto animate-fade-up-4">
				<!-- ESTADO 1: Cápsula integrada minimalista (#state-form) -->
				<div id="state-form">
					<form
						id="vip-form"
						data-endpoint={import.meta.env.PUBLIC_WEBHOOK_URL ||
							"https://script.google.com/macros/s/AKfycbw6hLROxqC1mIc2-BG8mfqdWTtqAriYIzTm59JnGsA4Tm3EuH7MWXz1kkj1ZPqlbPgb/exec"}
						class="w-full flex flex-col items-center"
					>
						<div
							class="relative neon-pill flex items-center p-1 sm:p-1.5 rounded-full bg-[#160402]/75 backdrop-blur-md border border-[#F7E6CA]/25 focus-within:border-[#F29F38] transition-all w-full"
						>
							<!-- Campo Honeypot anti-bots (invisible para humanos) -->
							<input
								type="text"
								name="website"
								tabindex="-1"
								autocomplete="off"
								aria-hidden="true"
								class="absolute opacity-0 pointer-events-none w-0 h-0 -z-10"
							/>
							<input
								id="vip-email-input"
								type="email"
								required
								placeholder="Tu correo electrónico"
								aria-label="Tu correo electrónico"
								class="flex-1 min-w-0 bg-transparent px-3.5 sm:px-4 py-2 sm:py-2.5 text-[13px] sm:text-base text-[#FFFDF9] placeholder-[#F7E6CA]/45 font-['Montserrat'] focus:outline-none select-text"
							/>
							<button
								id="vip-submit-btn"
								type="submit"
								data-i18n="ctaSubmit"
								class="neon-cta rounded-full px-4 sm:px-7 py-2.5 sm:py-3 bg-gradient-to-r from-[#F29F38] via-[#ffae42] to-[#e08922] hover:from-[#ffc066] hover:to-[#F29F38] text-[#160402] font-['Montserrat'] font-semibold text-[10.5px] sm:text-xs md:text-[13px] tracking-[0.11em] sm:tracking-[0.16em] uppercase whitespace-nowrap transition-all cursor-pointer"
							>
								Unirme al estreno
							</button>
						</div>

						<p
							data-i18n-html="formSubtext"
							class="font-['Montserrat'] font-light text-[11.5px] sm:text-sm text-[#F7E6CA]/75 tracking-wide mt-2 sm:mt-2.5 leading-relaxed text-balance"
						>
							Recibe el aviso de salida el <span
								class="whitespace-nowrap">12 de noviembre</span
							> y descubre los secretos de esta <strong
								class="font-medium text-[#F7E6CA]/95"
								>primera grabación mundial</strong
							>.
						</p>

						<!-- Consentimiento RGPD minimalista con checkbox joya/editorial a medida -->
						<div
							class="mt-2 sm:mt-2.5 flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-[10px] sm:text-[11.5px] font-['Montserrat'] font-light text-[#F7E6CA]/65 tracking-wider"
						>
							<label
								for="rgpd-consent"
								class="group inline-flex items-center gap-2 cursor-pointer select-none"
							>
								<span class="relative flex items-center justify-center w-3.5 h-3.5 sm:w-4 sm:h-4">
									<input
										id="rgpd-consent"
										name="consent"
										type="checkbox"
										required
										class="peer appearance-none w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-[4px] bg-[#160402]/80 backdrop-blur-sm border border-[#F7E6CA]/35 group-hover:border-[#F29F38]/75 checked:border-[#F29F38] checked:bg-[#F29F38]/20 checked:shadow-[0_0_10px_rgba(242,159,56,0.55)] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#F29F38] transition-all duration-200 cursor-pointer"
									/>
									<svg
										viewBox="0 0 12 12"
										fill="none"
										aria-hidden="true"
										class="pointer-events-none absolute w-2.5 h-2.5 sm:w-3 sm:h-3 text-[#F29F38] drop-shadow-[0_0_4px_rgba(242,159,56,0.8)] scale-0 peer-checked:scale-100 transition-transform duration-200 ease-out"
									>
										<path
											d="M2.2 6.2L4.8 8.8L9.8 3.2"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
								</span>
								<span
									data-i18n="rgpdPrefix"
									class="group-hover:text-[#F7E6CA]/90 transition-colors"
								>
									Acepto recibir el aviso del estreno y la
								</span>
							</label>
							<button
								type="button"
								id="open-privacy-modal"
								data-i18n="rgpdLink"
								class="underline decoration-[#F29F38]/55 hover:decoration-[#F29F38] underline-offset-2 text-[#F7E6CA]/85 hover:text-[#FFFDF9] transition-colors cursor-pointer"
							>
								Política de Privacidad
							</button>
						</div>
					</form>
				</div>

				<!-- ESTADO 2: Confirmación editorial sutil in-place (#state-success) -->
				<div
					id="state-success"
					class="hidden py-2 flex flex-col items-center gap-1.5 text-center animate-reveal"
				>
					<div class="flex items-center justify-center gap-2.5">
						<span
							class="w-6 h-px bg-gradient-to-r from-transparent to-[#F29F38]/70"
							aria-hidden="true"></span>
						<p
							data-i18n="successBadge"
							class="neon-subtitle font-['Montserrat'] font-light text-[11px] sm:text-xs text-[#FFFDF9] tracking-[0.22em] sm:tracking-[0.24em] uppercase whitespace-nowrap"
						>
							✦ Invitación activada para el estreno
						</p>
						<span
							class="w-6 h-px bg-gradient-to-l from-transparent to-[#F29F38]/70"
							aria-hidden="true"></span>
					</div>
					<button
						type="button"
						id="reopen-welcome-modal"
						data-i18n="reopenLetter"
						class="font-['Montserrat'] font-light text-[10.5px] sm:text-xs text-[#F29F38]/90 hover:text-[#FFFDF9] tracking-[0.18em] uppercase underline decoration-[#F29F38]/50 underline-offset-4 transition-colors cursor-pointer"
					>
						Leer carta de Mar Morán
					</button>
				</div>
			</div>
		</main>

		<!-- CAPA 3: Footer minimalista con Copyright y Contacto -->
		<footer
			class="relative z-20 w-full px-4 pb-2.5 sm:pb-3.5 text-center font-['Montserrat'] font-light text-[9.5px] sm:text-[11px] tracking-[0.16em] sm:tracking-[0.18em] uppercase text-[#F7E6CA]/45 animate-fade-up-4"
		>
			<span>© 2026 Mar Morán</span>
			<span class="mx-1.5 text-[#F29F38]/40" aria-hidden="true">·</span>
			<span data-i18n="footerContact">Contacto:</span>
			<a
				href="mailto:info@marmoransoprano.com"
				class="text-[#F7E6CA]/65 hover:text-[#F29F38] transition-colors lowercase tracking-[0.1em] ml-0.5 select-text"
				>info@marmoransoprano.com</a
			>
		</footer>

		<!-- Contenido semántico y repertorio completo indexable para buscadores (SEO) y lectores de pantalla -->
		<article class="sr-only">
			<h2>
				La Salerosa: Primera Grabación Mundial de las Canciones Líricas
				de Cristóbal Oudrid por Mar Morán y Aurelio Viribay
			</h2>
			<p>
				«La Salerosa» es la primera grabación mundial (World Premiere
				Recording) dedicada a las Canciones Líricas de Cristóbal Oudrid
				(1825–1877), uno de los compositores fundamentales de la
				zarzuela, la canción española y el patrimonio lírico del siglo
				XIX en España. En este álbum discográfico, la soprano Mar Morán
