				footerContact: "Contact:",
				successBadge: "✦ Premiere invitation activated",
				reopenLetter: "Read Mar Morán's letter",
				welcomeBadge: "Invitation confirmed · Nov 12",
				welcomeTitle: "Thank you for being on the other side",
				welcomeBody: `
					<p>What a joy to know you will be with me when <strong class="font-medium text-[#FFFDF9]">“La Salerosa”</strong> finally sees the light.</p>
					<p>Bringing to life alongside maestro <strong class="font-medium text-[#FFFDF9]">Aurelio Viribay</strong> these <em>Lyric Songs by Cristóbal Oudrid</em> —in their <strong class="font-medium text-[#FFFDF9]">world premiere recording</strong>— has been a journey of emotion, heritage, and beauty that I wished to share with you first.</p>
					<p>On <strong class="font-medium text-[#FFFDF9]">November 12</strong>, you will receive direct access to the premiere of the first single and exclusive details about the project in your inbox.</p>
				`,
				welcomeSignoff: "With all my love,",
				privacyTitle: "Privacy Policy",
				privacyBody: `
					<p><strong class="font-medium text-[#FFFDF9]">Data Controller:</strong> Mar Morán (<a href="mailto:info@marmoransoprano.com" class="underline decoration-[#F29F38]/60 underline-offset-2 text-[#FFFDF9] hover:text-[#F29F38]">info@marmoransoprano.com</a>).</p>
					<p><strong class="font-medium text-[#FFFDF9]">Purpose:</strong> To manage your subscription to the waiting list in order to send you the release alert for the single and album <em>“La Salerosa — Lyric Songs by Cristóbal Oudrid”</em>, as well as exclusive content about this world premiere recording.</p>
					<p><strong class="font-medium text-[#FFFDF9]">Legal Basis:</strong> Express consent of the data subject (Art. 6.1.a GDPR) granted by checking the acceptance box.</p>
					<p><strong class="font-medium text-[#FFFDF9]">Retention & Recipients:</strong> Your data will be kept only during the launch campaign or until you request removal. It will not be shared with third parties except by legal obligation (secure storage on Google Workspace).</p>
					<p><strong class="font-medium text-[#FFFDF9]">Rights:</strong> You may exercise your rights of access, rectification, erasure, restriction, and objection at any time by writing to <a href="mailto:info@marmoransoprano.com" class="underline decoration-[#F29F38]/60 underline-offset-2 text-[#FFFDF9] hover:text-[#F29F38]">info@marmoransoprano.com</a>.</p>
					<p class="text-[10px] text-[#F7E6CA]/55 pt-1 border-t border-[#F7E6CA]/15">This page does not use advertising or third-party tracking cookies.</p>
				`,
			},
		};

		let currentLang: Lang = "es";

		const openPrivacyBtn = document.getElementById("open-privacy-modal");
		const closePrivacyBtn = document.getElementById("close-privacy-modal");
		const privacyModal = document.getElementById("privacy-modal");

		const welcomeModal = document.getElementById("welcome-modal");
		const closeWelcomeBtn = document.getElementById("close-welcome-modal");
		const reopenWelcomeBtn = document.getElementById("reopen-welcome-modal");

		if (openPrivacyBtn && closePrivacyBtn && privacyModal) {
			openPrivacyBtn.addEventListener("click", () => {
				privacyModal.classList.remove("hidden");
			});
			closePrivacyBtn.addEventListener("click", () => {
				privacyModal.classList.add("hidden");
			});
			privacyModal.addEventListener("click", (e) => {
				if (e.target === privacyModal) {
					privacyModal.classList.add("hidden");
				}
			});
		}

		if (welcomeModal) {
			const hideWelcome = () => welcomeModal.classList.add("hidden");
			closeWelcomeBtn?.addEventListener("click", hideWelcome);
			reopenWelcomeBtn?.addEventListener("click", () => {
				welcomeModal.classList.remove("hidden");
			});
			welcomeModal.addEventListener("click", (e) => {
				if (e.target === welcomeModal) hideWelcome();
			});
		}

		window.addEventListener("keydown", (e) => {
			if (e.key === "Escape") {
				privacyModal?.classList.add("hidden");
				welcomeModal?.classList.add("hidden");
			}
		});
		const previewAudio = document.getElementById(
			"preview-audio",
		) as HTMLAudioElement | null;
		const soundToggle = document.getElementById(
			"sound-toggle",
		) as HTMLButtonElement | null;
		const soundLabel = document.getElementById(
			"sound-toggle-label",
		) as HTMLSpanElement | null;

		let isAudioPlaying = false;
		let fadeInterval: number | undefined;

		const updateSoundButtonText = () => {
			if (!soundToggle || !soundLabel) return;
			const t = translations[currentLang];
			soundToggle.setAttribute(
				"aria-label",
				isAudioPlaying ? t.soundAriaMute : t.soundAriaActivate,
			);
			soundLabel.textContent = isAudioPlaying
				? t.soundMute
				: t.soundActivate;
		};

		const langButtons =
			document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
		const emailInputEl = document.getElementById(
			"vip-email-input",
		) as HTMLInputElement | null;

		const setLanguage = (lang: Lang) => {
			currentLang = lang;
			document.documentElement.lang = lang;
			const t = translations[lang];

			document
				.querySelectorAll<HTMLElement>("[data-i18n]")
				.forEach((el) => {
					const key = el.getAttribute("data-i18n");
					if (key && t[key]) {
						el.textContent = t[key];
					}
				});

			document
				.querySelectorAll<HTMLElement>("[data-i18n-html]")
				.forEach((el) => {
					const key = el.getAttribute("data-i18n-html");
					if (key && t[key]) {
						el.innerHTML = t[key];
					}
				});

			if (emailInputEl) {
				emailInputEl.placeholder = t.emailPlaceholder;
				emailInputEl.setAttribute("aria-label", t.emailPlaceholder);
			}

			updateSoundButtonText();

			langButtons.forEach((btn) => {
				const isSelected = btn.getAttribute("data-lang-btn") === lang;
				btn.setAttribute("aria-pressed", String(isSelected));
				if (isSelected) {
					btn.classList.remove("font-light", "text-[#F7E6CA]/55");
					btn.classList.add("font-medium", "text-[#F29F38]");
				} else {
					btn.classList.remove("font-medium", "text-[#F29F38]");
					btn.classList.add("font-light", "text-[#F7E6CA]/55");
				}
			});

			try {
				window.localStorage.setItem("salerosa_lang", lang);
			} catch {
				// Ignore storage errors
			}
		};

		langButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				const selected = btn.getAttribute("data-lang-btn") as Lang;
				if (selected === "es" || selected === "en") {
					setLanguage(selected);
				}
			});
		});

		try {
			const urlLang = new URLSearchParams(window.location.search).get(
				"lang",
			);
			const savedLang = window.localStorage.getItem("salerosa_lang");
			if (urlLang === "en" || urlLang === "es") {
				setLanguage(urlLang);
			} else if (savedLang === "en" || savedLang === "es") {
				setLanguage(savedLang);
			}
		} catch {
			// Default ES
		}

		if (previewAudio && soundToggle && soundLabel) {
			soundToggle.addEventListener("click", () => {
				const willBeActive = !isAudioPlaying;
				isAudioPlaying = willBeActive;

				if (fadeInterval) {
					window.clearInterval(fadeInterval);
				}

				if (willBeActive) {
					if (!previewAudio.getAttribute("src") && previewAudio.dataset.src) {
						previewAudio.src = previewAudio.dataset.src;
					}
					previewAudio.volume = 0;
					previewAudio.play().catch(() => {});
					try {
						pageview({
							route: "/lasalerosa/evento/audio-play",
							path: "/lasalerosa/evento/audio-play",
						});
					} catch {
						// Ignorar si algún bloqueador detiene la analítica
					}
					let vol = 0;
					fadeInterval = window.setInterval(() => {
						vol = Math.min(1, vol + 0.08);
						previewAudio.volume = vol;
						if (vol >= 1) {
							window.clearInterval(fadeInterval);
						}
					}, 40);
				} else {
					let vol = previewAudio.volume;
					fadeInterval = window.setInterval(() => {
						vol = Math.max(0, vol - 0.12);
						previewAudio.volume = vol;
						if (vol <= 0) {
							previewAudio.pause();
							window.clearInterval(fadeInterval);
						}
					}, 35);
				}

				soundToggle.setAttribute(
					"data-sound-active",
					String(willBeActive),
				);
				soundToggle.setAttribute("aria-pressed", String(willBeActive));
				updateSoundButtonText();
			});
		}

		// Cuenta atrás en vivo hasta el lanzamiento del single (12 de noviembre a las 00:00h)
		const cdDays = document.getElementById("cd-days");
		const cdHours = document.getElementById("cd-hours");
		const cdMins = document.getElementById("cd-mins");
		const cdSecs = document.getElementById("cd-secs");

		const releaseDate = new Date("2026-11-12T20:00:00+01:00").getTime();

		const updateCountdown = () => {
			const now = Date.now();
			const diff = Math.max(0, releaseDate - now);

			const d = Math.floor(diff / (1000 * 60 * 60 * 24));
			const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
			const m = Math.floor((diff / (1000 * 60)) % 60);
			const s = Math.floor((diff / 1000) % 60);

			if (cdDays) cdDays.textContent = String(d).padStart(2, "0");
			if (cdHours) cdHours.textContent = String(h).padStart(2, "0");
			if (cdMins) cdMins.textContent = String(m).padStart(2, "0");
			if (cdSecs) cdSecs.textContent = String(s).padStart(2, "0");
		};

		updateCountdown();
		window.setInterval(updateCountdown, 1000);

		const vipForm = document.getElementById(
			"vip-form",
		) as HTMLFormElement | null;
		const stateForm = document.getElementById(
			"state-form",
		) as HTMLDivElement | null;
		const stateSuccess = document.getElementById(
			"state-success",
		) as HTMLDivElement | null;
		const formLoadedAt = Date.now();

		if (vipForm && stateForm && stateSuccess) {
			vipForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const input = vipForm.querySelector(
					'input[type="email"]',
				) as HTMLInputElement | null;
				const honeypot = vipForm.querySelector(
					'input[name="website"]',
				) as HTMLInputElement | null;
				const submitBtn = vipForm.querySelector(
					'button[type="submit"]',
				) as HTMLButtonElement | null;

				const email = input?.value.trim().toLowerCase() || "";
				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
				if (!email || !emailRegex.test(email)) return;

				const elapsedMs = Date.now() - formLoadedAt;
				const isBot = Boolean(honeypot?.value) || elapsedMs < 1200;

				let alreadyRegistered = false;
				try {
					alreadyRegistered =
						window.localStorage.getItem("salerosa_vip_email") ===
						email;
				} catch {
					// localStorage no disponible
				}

				// Si es un bot o ya había registrado ese mismo correo, mostramos éxito sin ensuciar el Google Sheet
				if (isBot || alreadyRegistered) {
					stateForm.classList.add("hidden");
					stateSuccess.classList.remove("hidden");
					welcomeModal?.classList.remove("hidden");
					return;
				}

				if (submitBtn) {
					submitBtn.disabled = true;
					submitBtn.textContent = translations[currentLang].ctaLoading;
				}

				const payload = {
					email,
					single: "La Salerosa",
					artist: "Mar Morán",
					createdAt: new Date().toISOString(),
					website: honeypot?.value || "",
					elapsedMs: String(elapsedMs),
				};

				const directWebhook = vipForm.dataset.endpoint;
				let sent = false;

				// 1. Intentar vía Serverless Function de Vercel (/lasalerosa/api/subscribe) para evitar bloqueos CORS
				try {
					const res = await fetch("/lasalerosa/api/subscribe", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							Accept: "application/json",
						},
						body: JSON.stringify(payload),
					});
					if (res.ok) {
						sent = true;
					}
				} catch {
					// En local (astro dev) pasamos al webhook directo
				}

				// 2. Fallback directo al Webhook (útil en astro dev local o plataformas estáticas)
				if (!sent && directWebhook) {
					try {
						await fetch(directWebhook, {
							method: "POST",
							mode: "no-cors",
							headers: {
								"Content-Type":
									"application/x-www-form-urlencoded;charset=UTF-8",
							},
							body: new URLSearchParams(payload).toString(),
						});
					} catch {
						// Fallback silencioso para no bloquear la experiencia visual
					}
				}

				try {
					window.localStorage.setItem("salerosa_vip_email", email);
				} catch {
					// Ignorar si está en modo privado restringido
				}

				stateForm.classList.add("hidden");
				stateSuccess.classList.remove("hidden");
				welcomeModal?.classList.remove("hidden");
			});
		}

		// 1. Ondas Armónicas Interactivas (hilos de luz/seda iterados en fase que responden al cursor/tacto y al sonido)
		const canvas = document.getElementById(
			"harmonic-waves",
		) as HTMLCanvasElement | null;
		if (canvas) {
			const ctx = canvas.getContext("2d");
			let width = (canvas.width = window.innerWidth);
			let height = (canvas.height = window.innerHeight);

			const pointer = {
				x: width * 0.5,
				y: height * 0.25,
				targetX: width * 0.5,
				targetY: height * 0.25,
				active: false,
				energy: 0,
			};

			window.addEventListener("resize", () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = window.innerHeight;
			});

			window.addEventListener("pointermove", (e) => {
				pointer.targetX = e.clientX;
				pointer.targetY = e.clientY;
				pointer.active = true;
				pointer.energy = Math.min(1, pointer.energy + 0.18);
			});

			window.addEventListener(
				"touchmove",
				(e) => {
					if (e.touches.length > 0) {
						pointer.targetX = e.touches[0].clientX;
						pointer.targetY = e.touches[0].clientY;
						pointer.active = true;
						pointer.energy = Math.min(1, pointer.energy + 0.22);
					}
				},
				{ passive: true },
			);

			let time = 0;
			const totalLines = 9;
			let cachedGrads: CanvasGradient[] = [];
			let lastFrameTime = 0;

			const buildLineGradients = () => {
				if (!ctx) return;
				cachedGrads = [];
				for (let i = 0; i < totalLines; i++) {
					const ratio = i / (totalLines - 1);
					const alpha = 0.14 + Math.sin(ratio * Math.PI) * 0.3;
					const lineGrad = ctx.createLinearGradient(0, 0, width, 0);
					lineGrad.addColorStop(0, "rgba(242, 159, 56, 0)");
					lineGrad.addColorStop(
						0.2,
						`rgba(242, 159, 56, ${alpha * 0.85})`,
					);
					lineGrad.addColorStop(0.5, `rgba(247, 230, 202, ${alpha})`);
					lineGrad.addColorStop(
						0.8,
						`rgba(242, 110, 20, ${alpha * 0.9})`,
					);
					lineGrad.addColorStop(1, "rgba(242, 159, 56, 0)");
					cachedGrads.push(lineGrad);
				}
			};

			buildLineGradients();
			window.addEventListener("resize", buildLineGradients);

			const render = (now: number) => {
				if (!ctx) return;
				if (document.hidden) {
					requestAnimationFrame(render);
					return;
				}
				const isMobileScreen = width < 640;
				// En móvil limitamos a ~30fps para ahorrar CPU/batería y reducir TBT a 0ms
				if (isMobileScreen && now - lastFrameTime < 32) {
					requestAnimationFrame(render);
					return;
				}
				lastFrameTime = now;

				ctx.clearRect(0, 0, width, height);

				pointer.x += (pointer.targetX - pointer.x) * 0.06;
				pointer.y += (pointer.targetY - pointer.y) * 0.06;
				pointer.energy *= 0.96;

				const audioBoost = isAudioPlaying ? 1.6 : 1.0;
				time += (isMobileScreen ? 0.02 : 0.012) * audioBoost;

				if (pointer.active && pointer.energy > 0.01) {
					const spotRadius = Math.max(width, height) * 0.28;
					const spotGrad = ctx.createRadialGradient(
						pointer.x,
						pointer.y,
						0,
						pointer.x,
						pointer.y,
						spotRadius,
					);
					spotGrad.addColorStop(
						0,
						`rgba(242, 159, 56, ${0.18 + pointer.energy * 0.14})`,
					);
					spotGrad.addColorStop(
						0.45,
						`rgba(212, 163, 131, ${0.07 + pointer.energy * 0.06})`,
					);
					spotGrad.addColorStop(1, "rgba(22, 4, 2, 0)");

					ctx.fillStyle = spotGrad;
					ctx.beginPath();
					ctx.arc(pointer.x, pointer.y, spotRadius, 0, Math.PI * 2);
					ctx.fill();
				}

				const baseY = height * 0.24;
				const amplitude =
					(height * 0.055 + pointer.energy * 18) *
					(isAudioPlaying ? 1.35 : 1);
				const steps = isMobileScreen ? 32 : 56;
				const influenceRadius = width * 0.35;

				for (let i = 0; i < totalLines; i++) {
					const phaseOffset = i * 0.22;

					ctx.strokeStyle = cachedGrads[i];
					ctx.lineWidth =
						i === Math.floor(totalLines / 2) ? 1.5 : 0.85;
					ctx.beginPath();

					for (let s = 0; s <= steps; s++) {
						const u = s / steps;
						const x = u * width;

						const wave1 =
							Math.sin(u * Math.PI * 2.2 + time - phaseOffset) *
							amplitude;
						const wave2 =
							Math.cos(
								u * Math.PI * 3.6 -
									time * 0.7 +
									phaseOffset * 1.4,
							) *
							(amplitude * 0.45);

						let pull = 0;
						if (pointer.active) {
							const distToPointer = Math.hypot(
								x - pointer.x,
								baseY - pointer.y,
							);
							if (distToPointer < influenceRadius) {
								const factor = 1 - distToPointer / influenceRadius;
								pull =
									factor *
									factor *
									(pointer.y - baseY) *
									(0.28 + pointer.energy * 0.25);
							}
						}

						const y =
							baseY +
							(i - totalLines / 2) * 7 +
							wave1 +
							wave2 +
							pull;

						if (s === 0) {
							ctx.moveTo(x, y);
						} else {
							ctx.lineTo(x, y);
						}
					}

					ctx.stroke();
				}

				requestAnimationFrame(render);
			};

			// Diferir el inicio del bucle de animación ambiental tras la carga inicial para dejar 0ms de bloqueo en LCP
			const startAmbientWaves = () => {
				window.setTimeout(() => {
					requestAnimationFrame(render);
				}, 1200);
			};

			if (document.readyState === "complete") {
				startAmbientWaves();
			} else {
				window.addEventListener("load", startAmbientWaves, { once: true });
			}
		}

		// 2. Constelación de las 16 Canciones del Disco: aparecen poco a poco con pausas limpias entre ellas
		const songContainer = document.getElementById(
			"song-constellation",
		) as HTMLDivElement | null;
		if (songContainer) {
			const songs = [
				"La Macarena",
				"La Salerosa",
				"Soledad",
				"La hamaca",
				"La pajarita",
				"La huevera de Fuencarral",
				"Malagueña",
				"Fugaz Ventura",
				"Tres por ciento",
				"Ojos negros y ojos azules",
				"Nueva rondalla Aragonesa",
				"El torero Rozicler",
				"El mareíto",
				"Me acuerdo",
				"Te acuerdas",
				"El tres por ciento",
			];

			const desktopZones = [
				{ left: "5%", topPct: 33, align: "left", dir: 1 },
				{ right: "5%", topPct: 34, align: "right", dir: -1 },
				{ left: "5%", topPct: 46, align: "left", dir: 1 },
				{ right: "5%", topPct: 47, align: "right", dir: -1 },
				{ left: "7%", topPct: 57, align: "left", dir: 1 },
				{ right: "7%", topPct: 56, align: "right", dir: -1 },
			];

			const mobileZones = [
				{ left: "4%", topPct: 42, align: "left", dir: 1 },
				{ right: "4%", topPct: 43, align: "right", dir: -1 },
				{ left: "4%", topPct: 53, align: "left", dir: 1 },
				{ right: "4%", topPct: 54, align: "right", dir: -1 },
			];

			const headerEl = document.querySelector("header");
			const mainEl = document.querySelector("main");

			let cachedMinTopPx = 180;
			let cachedMaxTopPx = 520;
			const updateBounds = () => {
				if (headerEl) {
					cachedMinTopPx = headerEl.getBoundingClientRect().bottom + 18;
				}
				if (mainEl) {
					cachedMaxTopPx = mainEl.getBoundingClientRect().top - 38;
				}
			};
			window.addEventListener("resize", updateBounds);

			let queue: string[] = [];
			let lastSong = "";
			let currentZoneIdx = 0;

			const refillQueue = () => {
				queue = [...songs];
				for (let i = queue.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[queue[i], queue[j]] = [queue[j], queue[i]];
				}
				if (queue[0] === lastSong && queue.length > 1) {
					[queue[0], queue[queue.length - 1]] = [
						queue[queue.length - 1],
						queue[0],
					];
				}
			};

			const ANIM_DURATION_MS = 3000;

			// Creamos un único nodo reutilizable en el DOM para no disparar MutationObservers de extensiones (como NordPass) cada 3 segundos
			const whisperEl = document.createElement("div");
			whisperEl.className =
				"song-whisper hidden absolute flex-col gap-0.5 sm:gap-1 pointer-events-none select-none";
			const whisperText = document.createElement("p");
			whisperText.className =
				"font-['Cinzel'] text-[clamp(0.68rem,2.6vw,0.8rem)] sm:text-[clamp(0.75rem,1.05vw,0.95rem)] tracking-[0.08em] sm:tracking-[0.14em] text-[#F7E6CA]/85 leading-snug max-w-[38vw] sm:max-w-none";
			const whisperStreak = document.createElement("div");
			whisperStreak.className =
				"song-whisper-streak w-[15vw] max-w-[72px] sm:w-28 sm:max-w-none";
			whisperEl.appendChild(whisperText);
			whisperEl.appendChild(whisperStreak);
			songContainer.appendChild(whisperEl);

			const scheduleNextWhisper = () => {
				const emptyPauseMs = 700 + Math.floor(Math.random() * 400);
				window.setTimeout(spawnSongWhisper, emptyPauseMs);
			};

			const spawnSongWhisper = () => {
				if (document.hidden) {
					scheduleNextWhisper();
					return;
				}
				if (queue.length === 0) refillQueue();
				const vh = window.innerHeight || 800;
				const isMobile = window.innerWidth < 640;
				const zones = isMobile ? mobileZones : desktopZones;
				const zone = zones[currentZoneIdx % zones.length];
				const songTitle = queue.shift()!;
				lastSong = songTitle;

				currentZoneIdx++;

				// Calculamos la posición vertical sin forzar un reflow síncrono
				let topPx = (zone.topPct / 100) * vh;
				if (topPx < cachedMinTopPx) topPx = cachedMinTopPx;
				if (topPx > cachedMaxTopPx) topPx = cachedMaxTopPx;

				whisperEl.style.left = zone.left || "";
				whisperEl.style.right = zone.right || "";
				whisperEl.style.top = `${Math.round(topPx)}px`;
				whisperEl.style.textAlign = zone.align;
				whisperEl.style.alignItems =
					zone.align === "right" ? "flex-end" : "flex-start";

				const travelX = isMobile ? 14 : 26;
				whisperEl.style.setProperty(
					"--tx-start",
					`${-travelX * zone.dir}px`,
				);
				whisperEl.style.setProperty("--ty-start", "4px");
				whisperEl.style.setProperty(
					"--tx-end",
					`${travelX * zone.dir}px`,
				);
				whisperEl.style.setProperty("--ty-end", "-4px");

				whisperText.textContent = songTitle;

				// Reiniciamos la animación en el siguiente frame sin forzar reflow síncrono (offsetWidth)
				requestAnimationFrame(() => {
					whisperEl.classList.remove("hidden");
					whisperEl.classList.add("flex");
				});

				window.setTimeout(() => {
					whisperEl.classList.add("hidden");
					whisperEl.classList.remove("flex");
					scheduleNextWhisper();
				}, ANIM_DURATION_MS);
			};

			const startWhisperLoop = () => {
				updateBounds();
				window.setTimeout(spawnSongWhisper, 1600);
			};

			if (document.readyState === "complete") {
				startWhisperLoop();
			} else {
				window.addEventListener("load", startWhisperLoop, { once: true });
			}
		}
	</script>
</Layout>
